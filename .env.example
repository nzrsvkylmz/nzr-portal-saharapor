# PostgreSQL bağlantısı (Railway: Postgres servisinin DATABASE_URL referansı)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saharapor

# Oturum token imzalama anahtarı (openssl rand -base64 32)
SESSION_SECRET=degistir-bunu

# Portal cookie jar şifreleme anahtarı — 32 byte base64 (openssl rand -base64 32)
ENCRYPTION_KEY=degistir-bunu

# Sistem Plus portal adresi
PORTAL_BASE_URL=https://nezir.sistem.plus

# İlk süper admin'in portal kullanıcı adı (ilk girişte otomatik SUPER_ADMIN atanır)
INITIAL_ADMIN_NICK=

# İleriki faz: GitHub Actions cron tetiklemesi için bearer token
CRON_TOKEN=
